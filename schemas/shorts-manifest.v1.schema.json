{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://localhost:3000/schemas/shorts-manifest.v1.json",
  "title": "YouTube Shorts manifest v1",
  "type": "object",
  "required": ["schemaVersion", "batchId", "channelAlias", "createdAt", "updatedAt", "status", "sources", "shorts", "revisions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "batchId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$" },
    "channelAlias": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["draft", "sources-ready", "audio-approved", "rendered", "uploaded"] },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "shorts": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/short" } },
    "revisions": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["sourceId", "videoId", "youtubeUrl", "title", "durationMs", "audioPath", "infoPath", "previewPath", "waveformPath", "sha256", "preparedAt"],
      "properties": {
        "sourceId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{6,20}$" },
        "videoId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{6,20}$" },
        "youtubeUrl": { "type": "string", "format": "uri" },
        "title": { "type": "string" },
        "channelTitle": { "type": "string" },
        "durationMs": { "type": "integer", "minimum": 1 },
        "thumbnailUrl": { "type": "string", "format": "uri" },
        "audioPath": { "type": "string" },
        "infoPath": { "type": "string" },
        "previewPath": { "type": "string" },
        "waveformPath": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "preparedAt": { "type": "string", "format": "date-time" }
      }
    },
    "short": {
      "type": "object",
      "required": ["id", "sourceId", "audioEdit", "relatedVideoId", "creativeNotes", "template", "status", "revision"],
      "properties": {
        "id": { "type": "string" },
        "sourceId": { "type": "string" },
        "audioEdit": {
          "type": "object",
          "required": ["startMs", "endMs", "loopCount", "crossfadeMs", "fadeInMs", "fadeOutMs"],
          "properties": {
            "startMs": { "type": "integer", "minimum": 0 },
            "endMs": { "type": "integer", "exclusiveMinimum": 0 },
            "loopCount": { "type": "integer", "minimum": 1, "maximum": 20 },
            "crossfadeMs": { "type": "integer", "minimum": 0 },
            "fadeInMs": { "type": "integer", "minimum": 0 },
            "fadeOutMs": { "type": "integer", "minimum": 0 }
          }
        },
        "relatedVideoId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{6,20}$" },
        "creativeNotes": { "type": "string" },
        "template": { "enum": ["devotional-artwork", "mantra-lyrics", "temple-cinematic", "minimal-visualizer"] },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "accentColor": { "type": "string" },
        "status": { "type": "string" },
        "revision": { "type": "integer", "minimum": 1 },
        "submittedAt": { "type": "string", "format": "date-time" },
        "previewPath": { "type": "string" },
        "finalPath": { "type": "string" },
        "lastError": { "type": "string" }
      }
    }
  }
}
